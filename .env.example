# 複製成 .env.local（本機）或填到 Vercel 專案的 Environment Variables（正式）。
# ⚠️ 真正的金鑰只放 .env.local / Vercel，不要寫進程式、不要傳到聊天或 Git。

# ---------- 黑貓 PAY（超商 ibon 代碼繳費） ----------
# 金流代號（cust_id，也是取 Token 的帳號）與 API 密碼
CCAT_CUST_ID=
CCAT_API_PASSWORD=
# prod＝正式站（真的代碼、真的收款）；test＝測試站。正式網站一定要設 prod，否則結帳不會開
CCAT_ENV=test
# 繳費完成通知網址（不填就用 SITE_URL 自動組成 https://<網域>/api/payments/ccat/notify，或黑貓 PAY 後台設定的回傳網址）
CCAT_APN_URL=
SITE_URL=
# 規格要求的繳款人資料（平台只收 Email；這幾欄先帶公司資料）（繳款人手機由玩家結帳時填）
CCAT_PAYER_NAME=
CCAT_PAYER_POSTCODE=
CCAT_PAYER_ADDRESS=

# ---------- 結帳總開關 ----------
# 兩個都設 1 才會發真的繳費代碼；沒開＝正式網站結帳停用、本機開發用模擬代碼
PAYMENTS_LIVE=0
NEXT_PUBLIC_PAYMENTS_LIVE=0
